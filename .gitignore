# Personal
.idea/
.DS_Store

# Google service-account keys — never commit
xenon-*.json
*-service-account*.json
personal/tmp/

# Obsidian vault config + plugins (not source; vault is reproducible via README)
.obsidian/

# gbrain local source-staging dir (capability checks, source clones) — runtime artifact
.sources/

# Yarn PnP / Yarn 2+ artifacts (using bun, not yarn)
.pnp.cjs
.pnp.loader.mjs
.yarn/
yarn.lock

# /todo runtime state: per-machine last-list ordering with absolute paths (not source)
personal/todo/.last-list-order
